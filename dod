#!/usr/bin/env bash
# Dev wrapper for DOD 2026. Every tool runs in Docker, nothing is installed in WSL.
# On Windows, dod.bat (windows/dod.ps1) has the same commands.
#
#   ./dod --help     every command, one line each
#   ./dod --manual   how to use each command, and full commands that launch the app
#
# The project is mounted at /work. DOD_SERIAL says which board to talk to:
# "sim" (default, the simulated board), /dev/ttyUSB0, or socket://host:port.
# The first serial port found is passed into the container; ESP_PORT picks
# another one.
#
# `./dod test` runs each suite on its own (src/hcl, src/backend, then
# src/frontend), because each has its own settings. A path picks its suite by
# itself: `./dod test src/backend/tests/test_imports.py -k relative`. Extra
# arguments go to pytest, or to Vitest for `./dod test frontend`.
#
# Node never runs in WSL: npm, Vite and Vitest run in the Node image, with
# npm's cache in a Docker volume so `npm ci` doesn't download everything again.
set -euo pipefail

IMAGE=dod2026
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_IMAGE=node:22.23.4-slim
NPM_CACHE=dod2026-npm  # Docker volume
NETWORK=dod2026-dev  # ./dod sim and dev: Vite reaches the backend by its container name
FRONTEND=src/frontend
HCL_TOOLS=(monitor pattern bench repl)
SUITES=(hcl backend frontend)
PORT_HTTP=8000
PORT_VITE=5173

# The backend with reloading. The settings are checked once before uvicorn
# starts: with --reload, a bad one would otherwise leave the reloader waiting
# for a file change that can't fix an environment variable.
BACKEND_CMD=(sh -c 'python -c "from dod.main import settings_or_exit; settings_or_exit()" && exec "$@"' sh
             uvicorn --factory dod.main:create_app --host 0.0.0.0 --port "$PORT_HTTP"
             --reload --reload-dir src/backend --reload-dir src/hcl --ws-max-size 65536)

usage() {
    echo "usage: ./dod <command> [args]   (./dod --help lists the commands, ./dod --manual explains them)" >&2
    exit 1
}

show_help() {
    cat <<'EOF'
DOD 2026 dev wrapper: every tool runs in Docker, nothing is installed in WSL.

usage: ./dod <command> [args]

Run the app
  sim                                     backend + Vite on http://localhost:5173, simulated board
  dev                                     the same with the real board (/dev/ttyUSB0, or DOD_SERIAL)
  backend                                 the backend alone on http://localhost:8000 (builds the frontend first if it changed)
  notebook                                the notebook's self-contained image, run here on http://localhost:8000

Test
  test [hcl|backend|frontend] [args]      all three suites, or one; extra args go to pytest / Vitest
  backend-soak [--minutes N|--seconds N]  the soak test: a simulated open day (default 30 min)

Build
  build                                   (re)build the dev image
  frontend-build                          build the frontend into src/frontend/dist (what backend serves)
  schema                                  write the WebSocket JSON Schema and the TypeScript types
  npm <args>                              any npm command, in a Node container, in src/frontend

Songs
  songs [id ...]                          download the songs from songs.txt missing from cache/, make their light shows

The board
  hcl monitor [--send] [--seconds N]      watch the link: a status line every second, every event
  hcl pattern [--speed X]                 wiring test: colours, the strip, the 8x8's rows and columns
  hcl bench [--seconds N] [--max-fps N]   speed test, ends with PASS or FAIL
  hcl repl                                ask main.py to step aside, for the Python prompt
  esp upload                              put src/hcl/esp/ (and protocol.py) on the board, reset it
  esp run <file.py>                       run a MicroPython script on the board, its output here
  esp repl                                a Python prompt on the board

Other
  shell                                   a bash shell in the container
  -h, --help                              this list
  --manual                                how to use each command, and full commands to launch the app

On Windows: dod.bat, the same commands (dod --help there).

Settings: any DOD_* variable reaches the backend, e.g.  DOD_BRIGHTNESS=0.3 ./dod sim
DOD_SERIAL picks the board: sim (default), /dev/ttyUSB0, socket://host:port.
EOF
}

show_manual() {
    cat <<'EOF'
DOD 2026 - MANUAL
=================

Every command runs from the project folder, in WSL:

    cd ~/spseke/dod2026

./dod needs Docker. In Claude Code it must run outside the sandbox (inside
it, Docker's socket is blocked: "permission denied ... docker.sock").
The first command builds the dev image by itself (a few minutes, needs
internet); after that everything starts in seconds.


1. LAUNCHING THE APP
--------------------

1.1  Development, simulated board (no hardware needed)

    ./dod sim

  Then, in a browser on Windows:

    http://localhost:5173                            the phone page (what visitors see)
    http://localhost:5173/internal/main?key=dev      the main screen (click "Spustit" once, for the sound)
    http://localhost:5173/internal/logging?key=dev   the fake terminal on its own
    http://localhost:5173/components.html            every component, with fake data

  Code changes reload by themselves, backend and frontend. Ctrl+C stops both.
  Two visitors at once: a normal and a private window (F12 > device toolbar
  makes them phone-sized).

  With the Wi-Fi QR code on the main screen:

    DOD_WIFI_SSID=DOD2026 DOD_WIFI_PASSWORD=heslo1234 ./dod sim

  With a simulated board that misbehaves (unplugged every 30 s for 5 s):

    DOD_SERIAL='sim?unplug_every=30&unplug_for=5' ./dod dev

  (other options: latency_ms, drop, garbage, reboot_every, led_count,
  color_order, seed - docs/hcl.md section 6)

1.2  Development, the real board in WSL

  In Windows PowerShell as administrator, the first time only:

    usbipd list                       find the board ("CP210x"), note its BUSID, e.g. 2-3
    usbipd bind --busid 2-3

  Every time the board is plugged in (PowerShell, no admin needed after bind):

    usbipd attach --wsl --busid 2-3

  Then in WSL:

    ./dod hcl pattern                 optional: check the wiring first
    ./dod dev

  Same addresses as 1.1. A board on another port:

    DOD_SERIAL=/dev/ttyUSB1 ESP_PORT=/dev/ttyUSB1 ./dod dev

1.3  The built app on port 8000 (the way the notebook serves it, code mounted)

    ./dod frontend-build
    ./dod backend

    http://localhost:8000
    http://localhost:8000/internal/main?key=dev

  ./dod backend runs frontend-build by itself when the frontend changed since
  the last one. The backend reloads on save; the frontend doesn't (start
  ./dod backend again, or run frontend-build). With the board:  DOD_SERIAL=/dev/ttyUSB0 ./dod backend

1.4  The notebook's image, tried in WSL first

    ./dod notebook                              simulated board
    DOD_SERIAL=/dev/ttyUSB0 ./dod notebook      the real board (attached as in 1.2)

    http://localhost:8000
    http://localhost:8000/internal/main?key=dev

  It builds the image first (a few minutes the first time, needs internet).
  The code is inside the image, so after a change run it again: it rebuilds.

1.5  On the notebook (Windows) - the open day

  Once beforehand: Docker Desktop installed, the whole project folder copied
  over (with cache\ and its songs), the image built once with internet
  (start.bat does that on its first run).

  On the day: turn on the Mobile Hotspot (Settings > Network & internet >
  Mobile hotspot), plug in the board's USB cable and the 5 V supply, then
  double-click start.bat in the project folder - or from a Command Prompt:

    cd C:\path\to\dod2026
    start.bat

  It starts Docker Desktop, finds the board, starts the serial bridge, brings
  the image up to the folder's code (seconds when nothing changed), runs the
  backend and opens the main screen full screen. Phones scan the QR code
  (normally http://192.168.137.1:8000). To stop: close the main screen
  (Alt+F4) or press Ctrl+C in the console. Logs of the last run:
  %TEMP%\dod2026\ (bridge.log, backend.log).

  Options:

    start.bat -Simulated                                  no board, no bridge
    start.bat -Port COM5                                  the board's COM port, if it isn't found
    start.bat -WifiSsid DOD2026 -WifiPassword heslo1234   if the hotspot's name can't be read

  (start.bat and the bridge are written but not tested on Windows yet:
  docs/plans/hcl.md, stage 3.)

  Every other command works on Windows too: dod.bat has the same commands
  as ./dod (dod --help, dod --manual), in Docker Desktop, the board through
  the serial bridge. E.g. in a Command Prompt in the project folder:

    dod songs
    dod test
    dod sim

1.6  Real phones during development

  WSL forwards ports to Windows' localhost only, so a phone can't reach
  ./dod sim until, on Windows:

    1. %UserProfile%\.wslconfig gets   [wsl2]  networkingMode=mirrored
    2. wsl --shutdown, then open WSL again
    3. Windows Firewall allows port 5173

  Then the phone (on the same Wi-Fi) opens http://<the PC's IP>:5173, and the
  main screen's QR code points there with:

    DOD_PUBLIC_URL=http://192.168.1.20:5173 ./dod sim


2. THE COMMANDS
---------------

./dod sim
    The backend (port 8000, simulated board) and the Vite dev server (port
    5173) in two containers; the browser only talks to 5173, which forwards
    /api, /ws and /media to the backend. The internal key is "dev" (change:
    DOD_INTERNAL_KEY=...). Refuses to start if another sim or backend runs.

./dod dev
    The same as sim, with DOD_SERIAL (default /dev/ttyUSB0): the real board,
    or any sim?... URL.

./dod backend
    The backend alone on http://localhost:8000, reloading on every save. It
    serves src/frontend/dist, and builds it first (./dod frontend-build) when
    the frontend's source is newer than that build.

./dod notebook
    Builds the self-contained image (dod2026-notebook: the code and the built
    frontend inside, only cache/ mounted) and runs it on port 8000, like
    start.bat does on the notebook. DOD_SERIAL=/dev/ttyUSB0 for the board.

./dod test [hcl|backend|frontend] [args]
    All three suites one after another, or one. A path picks its suite by
    itself. Extra arguments go to pytest (hcl, backend) or Vitest (frontend).

        ./dod test
        ./dod test backend -x
        ./dod test src/backend/tests/test_queue.py -k turn
        ./dod test frontend tests/phone.test.tsx

./dod backend-soak [--minutes N | --seconds N]
    The whole backend for a long while under a simulated open day: 8 phones,
    a main screen playing songs, a logging page, the board unplugged every
    1-2 min. Prints a line a minute; PASS needs no errors, memory within
    10 MB and 30 fps (+-1) every second. Runs next to ./dod sim. Don't use
    the machine heavily meanwhile, or the fps check fails for no real reason.

        ./dod backend-soak                 30 minutes (the step 10 check)
        ./dod backend-soak --seconds 120   a quick try

./dod build
    (Re)builds the dev image (the Dockerfile's dev stage: the dependencies
    only, the code is mounted). Needed after a dependency changes.

./dod frontend-build
    Type-checks and builds the frontend into src/frontend/dist, which
    ./dod backend serves.

./dod schema
    After changing a message in src/backend/dod/api/messages.py: writes the
    JSON Schema and the frontend's TypeScript types (both committed; the
    tests fail when they are out of date).

./dod npm <args>
    Any npm command in src/frontend, in the Node container.

        ./dod npm install --save-exact <package>
        ./dod npm ls react

./dod songs [id ...]
    Downloads the songs from src/backend/dod/music/songs.txt that are not in
    cache/ yet (~30 MB and ~15 s each, needs internet). With ids: only those.
    Then works out the light show of every downloaded song that has none, or
    one from an older version of the show (<id>.show.png, shown under the
    video on the main screen; ~8 s each, no internet needed). After changing
    the show (music.py, audio.py), run it again: old pictures aren't shown.

        ./dod songs
        ./dod songs dQw4w9WgXcQ

./dod hcl monitor [--send] [--seconds N]
    Connects to the board, prints a status line every second and every
    event - the first thing to run when something is wrong. --send adds a
    dim test frame at 30 fps, so fps and round trips mean something.

./dod hcl pattern [--speed X]
    Wiring test; says what should be lit at each step: the strip red, green,
    blue, one LED walking along it, each 8x8 row and column, a brightness
    ramp. --speed 2 is twice as fast.

./dod hcl bench [--seconds N] [--max-fps N]
    Frames as fast as the board answers, for 20 s; prints fps, round trips,
    timeouts, then PASS (>= 45 fps, no timeouts) or FAIL.

./dod hcl repl
    Asks main.py to stop, so a Python prompt can take over. Exit code 2
    ("didn't answer") is fine when the board is at >>> already.

    The hcl tools use the attached board when DOD_SERIAL isn't set, the
    simulator otherwise (DOD_SERIAL=sim ./dod hcl bench). They all take
    --url. The backend must not run at the same time: one port, one program.

./dod esp upload
    Copies src/hcl/esp/ and protocol.py to the board and resets it. Run it
    after changing anything in src/hcl/esp/ or src/hcl/hcl/protocol.py.

./dod esp run <file.py>
    Runs a MicroPython script on the board without saving it; its output
    comes here.

        ./dod esp run src/hcl/esp_tests/protocol_selftest.py
        ./dod esp run src/hcl/esp_tests/strip_test.py

./dod esp repl
    A Python prompt on the board (Ctrl+] leaves). The board's own program
    starts again after a reset (EN button).

./dod shell
    A bash shell in the dev container, the project at /work.


3. SETTINGS
-----------

Every DOD_* variable in your shell reaches the backend's container. A wrong
value or an unknown name stops the backend with a message naming it.

    DOD_SERIAL            sim          the board: sim, sim?option=value, /dev/ttyUSB0, socket://host:port
    DOD_BAUD              115200       the serial speed
    DOD_LED_COUNT         10           used until the board says how many it has
    DOD_POWER_LIMIT_MA    1500         the strip's current limit
    DOD_BRIGHTNESS        0.8          master brightness, 0-1
    DOD_TURN_SECONDS      180          how long a visitor's turn lasts
    DOD_INACTIVE_SECONDS  30           no command (or offline) this long: the turn ends
    DOD_IDLE_SECONDS      30           nobody plays this long: idle mode
    DOD_AUDIO_DELAY_MS    0            delay the lights, for a Bluetooth speaker (0-2000)
    DOD_INTERNAL_KEY      dev / random the key for /internal/* (./dod: dev; start.bat: random)
    DOD_PUBLIC_URL        localhost    the address in the phones' QR code (sim/dev: :5173, else :8000)
    DOD_CACHE_DIR         /work/cache  where the songs are
    DOD_LOG_LEVEL         INFO         the backend's real log
    DOD_WIFI_SSID         -            the hotspot's name, for the Wi-Fi QR code (with the password)
    DOD_WIFI_PASSWORD     -            its password, 8-63 characters

    ESP_PORT              (first found) which /dev/tty* goes into the container

Examples:

    DOD_BRIGHTNESS=0.3 ./dod sim
    DOD_TURN_SECONDS=30 DOD_IDLE_SECONDS=10 ./dod sim
    DOD_AUDIO_DELAY_MS=200 ./dod notebook


4. WHEN SOMETHING IS WRONG
--------------------------

"permission denied ... docker.sock"
    ./dod ran inside Claude Code's sandbox; run it outside.

"already running: dod2026-backend ..."
    Another ./dod sim or ./dod backend runs. Stop it (Ctrl+C there), or:
        docker stop dod2026-backend dod2026-vite

"no board found" / "no such port"
    Attach the board to WSL (1.2), check with:  ls /dev/ttyUSB*

The strip or the 8x8 stays dark
    ./dod hcl monitor shows whether the board answers; ./dod hcl pattern
    whether the wiring is right; ./dod esp run src/hcl/esp_tests/strip_test.py
    drives the strip from the board alone.

A quick look at a running backend
    curl localhost:8000/api/status     (board link, fps, mode, connections)

More: docs/handoff.md (where things stand), docs/tech-spec.md (the design),
docs/hcl.md (the board), docs/backend.md (the backend).
EOF
}

# --help and --manual work without Docker
case "${1:-}" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    --manual|manual)
        if [[ -t 1 ]] && command -v less >/dev/null; then
            show_manual | less -FRX
        else
            show_manual
        fi
        exit 0
        ;;
esac

if ! command -v docker >/dev/null; then
    echo "dod: docker is not installed (see ~/spseke/esp/setup/README.md, One-time setup)" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

if [[ "$1" == "build" ]]; then
    exec docker build --target dev -t "$IMAGE" "$DIR"
fi

# The board's serial port: ESP_PORT, else the first one found; empty without a board
find_port() {
    if [[ -n "${ESP_PORT:-}" ]]; then
        echo "$ESP_PORT"
        return
    fi
    local p
    for p in /dev/ttyUSB* /dev/ttyACM*; do
        if [[ -e "$p" ]]; then
            echo "$p"
            return
        fi
    done
}

# docker run arguments shared by every command
docker_args() {
    if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
        docker build --target dev -t "$IMAGE" "$DIR" >&2
    fi
    # Run as the calling user, so files written to /work are not owned by root.
    args=(--rm --init -i -v "$DIR:/work" -w /work --user "$(id -u):$(id -g)"
          -e HOME=/tmp -e PYTHONUNBUFFERED=1 -e DOD_SERIAL="${DOD_SERIAL:-sim}")
    # every other DOD_ setting from the calling shell goes in too (docs/backend.md 11),
    # e.g. DOD_BRIGHTNESS=0.3 ./dod backend
    local var
    for var in $(compgen -e); do
        if [[ "$var" == DOD_* && "$var" != DOD_SERIAL ]]; then
            args+=(-e "$var")
        fi
    done
    if [[ -t 0 && -t 1 ]]; then
        args+=(-t)
    fi

    local port
    port="$(find_port)"
    if [[ -n "$port" ]]; then
        # The port's owning group (usually dialout) is what grants access to it.
        args+=(--device "$port" --group-add "$(stat -c %g "$port")" -e ESPTOOL_PORT="$port")
    elif [[ "${DOD_SERIAL:-sim}" == /dev/* ]]; then
        echo "dod: DOD_SERIAL=$DOD_SERIAL but no serial port found, is the board attached? (usbipd attach --wsl --busid <id>)" >&2
    fi
}

# docker run arguments for the Node container, in src/frontend
node_args() {
    if ! docker volume inspect "$NPM_CACHE" >/dev/null 2>&1; then
        docker volume create "$NPM_CACHE" >/dev/null
        # a new volume belongs to root, and npm runs as the calling user
        docker run --rm -v "$NPM_CACHE:/cache" "$NODE_IMAGE" chown "$(id -u):$(id -g)" /cache
    fi
    nargs=(--rm --init -i -v "$DIR:/work" -w "/work/$FRONTEND" --user "$(id -u):$(id -g)"
           -e HOME=/tmp -v "$NPM_CACHE:/cache" -e npm_config_cache=/cache
           -e npm_config_update_notifier=false -e npm_config_fund=false)
    if [[ -t 0 && -t 1 ]]; then
        nargs+=(-t)
    fi
}

# npm ci when node_modules is missing or older than the lock file
ensure_node_modules() {
    local lock="$DIR/$FRONTEND/package-lock.json" installed="$DIR/$FRONTEND/node_modules/.package-lock.json"
    if [[ ! -f "$installed" || "$lock" -nt "$installed" ]]; then
        echo "dod: installing the frontend's packages (npm ci)" >&2
        docker run "${nargs[@]}" "$NODE_IMAGE" npm ci >&2
    fi
}

# ./dod backend serves src/frontend/dist: build it first when it's missing or
# older than the frontend's source (or the backend's schema, which its type
# check reads), so port 8000 never shows an old frontend without saying so.
frontend_if_changed() {
    local f="$DIR/$FRONTEND" built="$DIR/$FRONTEND/dist/index.html"
    if [[ -f "$built" && -z "$(find "$f/src" "$f/index.html" "$f/components.html" "$f/package-lock.json" \
            "$f/vite.config.ts" "$f/tsconfig.json" "$f/tsconfig.node.json" "$DIR/src/backend/schema" \
            -newer "$built" -print -quit)" ]]; then
        return
    fi
    echo "dod: the frontend changed since the last frontend-build, building it" >&2
    node_args
    ensure_node_modules
    if ! docker run "${nargs[@]}" "$NODE_IMAGE" npm run build >&2; then
        echo "dod: the frontend didn't build (the errors are above)" >&2
        exit 1
    fi
}

# ./dod sim and ./dod dev: the backend in the background, Vite in front.
# The browser only talks to Vite (5173), which forwards /api, /ws and /media.
# Ctrl-C stops both.
dev_stack() {
    export DOD_SERIAL="$1"  # docker_args passes it into the backend's container
    # The pages come from Vite here: the backend's printed links and the QR code
    # point at it, not at port 8000 (that serves the last ./dod frontend-build,
    # which is easy to open by mistake and then shows old code).
    export DOD_PUBLIC_URL="${DOD_PUBLIC_URL:-http://localhost:$PORT_VITE}"
    docker_args
    node_args
    ensure_node_modules
    if ! docker network inspect "$NETWORK" >/dev/null 2>&1; then
        docker network create "$NETWORK" >/dev/null
    fi
    # Neither container gets a terminal (-t) or stdin (-i): with a terminal,
    # Docker puts this one into raw mode, and the other container's lines then
    # start where the last one ended instead of at the left edge. Both run in
    # the background, and Ctrl-C is handled here: Vite without a terminal
    # ignores SIGINT, so the trap stops both containers (SIGTERM).
    local bg=() fg=() a key="${DOD_INTERNAL_KEY:-dev}"
    for a in "${args[@]}"; do
        if [[ "$a" != "-t" && "$a" != "-i" ]]; then
            bg+=("$a")
        fi
    done
    for a in "${nargs[@]}"; do
        if [[ "$a" != "-t" && "$a" != "-i" ]]; then
            fg+=("$a")
        fi
    done
    # another ./dod sim (or ./dod backend) already runs: say so, and leave its
    # containers alone (the trap below would stop them)
    local running
    running=$(docker ps --filter name='^dod2026-(backend|vite)$' --format '{{.Names}}' | tr '\n' ' ')
    if [[ -n "$running" ]]; then
        echo "dod: already running: ${running}(another ./dod sim or ./dod backend); stop it first" >&2
        exit 1
    fi
    trap 'docker stop dod2026-backend dod2026-vite >/dev/null 2>&1 || true' EXIT
    trap 'echo; echo "dod: stopping" >&2; exit 130' INT TERM
    docker run "${bg[@]}" --name dod2026-backend --network "$NETWORK" -p "$PORT_HTTP:$PORT_HTTP" \
        -e DOD_INTERNAL_KEY="$key" "$IMAGE" "${BACKEND_CMD[@]}" &
    echo "dod: http://localhost:$PORT_VITE  (internal pages: /internal/main?key=$key, /internal/logging?key=$key)" >&2
    docker run "${fg[@]}" --name dod2026-vite --network "$NETWORK" -p "$PORT_VITE:$PORT_VITE" \
        -e DOD_BACKEND="http://dod2026-backend:$PORT_HTTP" "$NODE_IMAGE" \
        npx vite --host 0.0.0.0 --port "$PORT_VITE" --strictPort &
    # until Ctrl-C, or until either one ends by itself (then the trap stops the other)
    wait -n
}

run_tests() {
    local suites=("${SUITES[@]}") picked="" paths=false
    if [[ " ${SUITES[*]} " == *" ${1:-} "* ]]; then
        picked="$1"
        shift
    fi
    # a path inside one suite picks that suite
    for a in "$@"; do
        for s in "${SUITES[@]}"; do
            if [[ "$a" == "src/$s" || "$a" == src/$s/* ]]; then
                paths=true
                if [[ -n "$picked" && "$picked" != "$s" ]]; then
                    echo "dod: '$a' is not in the $picked suite; run one suite at a time" >&2
                    exit 1
                fi
                picked="$s"
            fi
        done
    done
    if [[ -n "$picked" ]]; then
        suites=("$picked")
    fi

    docker_args
    local result=0 status
    for s in "${suites[@]}"; do
        if [[ ${#suites[@]} -gt 1 ]]; then
            echo "=== $s (src/$s)"
        fi
        status=0
        if [[ "$s" == frontend ]]; then
            # type check, the generated types' check, then Vitest; arguments
            # only when this suite was picked (pytest's would mean nothing here)
            local vargs=()
            if [[ -n "$picked" ]]; then
                for a in "$@"; do
                    vargs+=("${a#"$FRONTEND/"}")  # paths are relative to src/frontend inside
                done
            fi
            node_args
            ensure_node_modules
            docker run "${nargs[@]}" "$NODE_IMAGE" npm test -- "${vargs[@]}" || status=$?
        else
            local cmd=(python -m pytest)
            if ! $paths; then
                cmd+=("src/$s")
            fi
            docker run "${args[@]}" "$IMAGE" "${cmd[@]}" "$@" || status=$?
        fi
        if [[ $status -eq 5 ]]; then
            # pytest exits with 5 when there are no tests yet; that is not a failure.
            echo "dod: no tests in src/$s yet"
        elif [[ $status -ne 0 ]]; then
            result=$status
        fi
    done
    exit $result
}

case "$1" in
    test)
        shift
        run_tests "$@"
        ;;
    backend)
        frontend_if_changed
        docker_args
        # Published on WSL's port 8000, which WSL also forwards to Windows' localhost.
        # The dev key opens the internal pages: /internal/main?key=dev (docs/backend.md 9).
        args+=(--name dod2026-backend -p "$PORT_HTTP:$PORT_HTTP" -e DOD_INTERNAL_KEY="${DOD_INTERNAL_KEY:-dev}")
        exec docker run "${args[@]}" "$IMAGE" "${BACKEND_CMD[@]}"
        ;;
    notebook)
        # The image start.ps1 runs on the notebook (Dockerfile, target notebook),
        # tried here first: nothing mounted but cache/, the simulated board unless
        # DOD_SERIAL says otherwise. http://localhost:8000, /internal/main?key=dev
        docker build -t dod2026-notebook "$DIR"
        nb=(--rm --init -i --name dod2026-notebook -p "$PORT_HTTP:$PORT_HTTP" -v "$DIR/cache:/work/cache"
            -e DOD_SERIAL="${DOD_SERIAL:-sim}" -e DOD_INTERNAL_KEY="${DOD_INTERNAL_KEY:-dev}")
        # every other DOD_ setting too, e.g. DOD_AUDIO_DELAY_MS=200 ./dod notebook
        for var in $(compgen -e); do
            if [[ "$var" == DOD_* && "$var" != DOD_SERIAL && "$var" != DOD_INTERNAL_KEY ]]; then
                nb+=(-e "$var")
            fi
        done
        if [[ -t 0 ]]; then
            nb+=(-t)
        fi
        # DOD_SERIAL=/dev/ttyUSB0 ./dod notebook: the board goes in too
        if [[ "${DOD_SERIAL:-sim}" == /dev/* ]]; then
            if [[ ! -e "$DOD_SERIAL" ]]; then
                echo "dod: DOD_SERIAL=$DOD_SERIAL but no such port, is the board attached? (usbipd attach --wsl --busid <id>)" >&2
                exit 1
            fi
            nb+=(--device "$DOD_SERIAL" --group-add "$(stat -c %g "$DOD_SERIAL")")
        fi
        exec docker run "${nb[@]}" dod2026-notebook
        ;;
    sim)
        dev_stack sim
        ;;
    dev)
        dev_stack "${DOD_SERIAL:-/dev/ttyUSB0}"
        ;;
    npm)
        shift
        node_args
        exec docker run "${nargs[@]}" "$NODE_IMAGE" npm "$@"
        ;;
    frontend-build)
        node_args
        ensure_node_modules
        exec docker run "${nargs[@]}" "$NODE_IMAGE" npm run build
        ;;
    schema)
        # the JSON Schema from the Pydantic models, then the TypeScript types from it
        docker_args
        docker run "${args[@]}" "$IMAGE" python -m dod.api.schema
        node_args
        ensure_node_modules
        exec docker run "${nargs[@]}" "$NODE_IMAGE" npm run --silent types
        ;;
    backend-soak)
        # the backend on its own port inside this container: nothing published,
        # so it can run next to ./dod sim (docs/plans/backend.md, step 10)
        shift
        docker_args
        exec docker run "${args[@]}" "$IMAGE" python src/backend/tests/soak.py "$@"
        ;;
    songs)
        # into cache/ in the project (DOD_CACHE_DIR, /work/cache); needs the internet
        shift
        docker_args
        exec docker run "${args[@]}" "$IMAGE" python -m dod.music.download "$@"
        ;;
    shell)
        docker_args
        exec docker run "${args[@]}" "$IMAGE" bash
        ;;
    esp)
        # the board's own code (docs/hcl.md 7, 9). main.py turns Ctrl-C off, so
        # first `hcl repl` asks it to step aside (exit 2: it didn't answer, fine
        # when the board is at the >>> prompt already), then mpremote takes over.
        sub="${2:-}"
        docker_args
        if [[ ! " ${args[*]} " == *" ESPTOOL_PORT="* ]]; then
            echo "dod: no board found (usbipd attach --wsl --busid <id>, see ~/spseke/esp/setup/README.md)" >&2
            exit 1
        fi
        step_aside='python -m hcl.tools.repl --url "$ESPTOOL_PORT"; s=$?; [ $s -le 2 ] || exit $s'
        case "$sub" in
            upload)
                exec docker run "${args[@]}" "$IMAGE" sh -c "$step_aside"'
                    cd src/hcl && mpremote connect "$ESPTOOL_PORT" \
                        cp esp/boot.py esp/config.py esp/max7219.py hcl/protocol.py : + \
                        cp esp/main.py : + reset'
                ;;
            run)
                [[ -n "${3:-}" ]] || { echo "usage: ./dod esp run <file.py>" >&2; exit 2; }
                exec docker run "${args[@]}" "$IMAGE" sh -c "$step_aside"'
                    mpremote connect "$ESPTOOL_PORT" run "$1"' sh "$3"
                ;;
            repl)
                exec docker run "${args[@]}" "$IMAGE" sh -c "$step_aside"'
                    mpremote connect "$ESPTOOL_PORT" repl'
                ;;
            *)
                echo "usage: ./dod esp upload | run <file.py> | repl" >&2
                exit 2
                ;;
        esac
        ;;
    hcl)
        tool="${2:-}"
        if [[ ! " ${HCL_TOOLS[*]} " == *" $tool "* ]]; then
            echo "dod: unknown HCL tool '$tool', pick one of: ${HCL_TOOLS[*]}" >&2
            exit 1
        fi
        # The tools are for the board: with one attached and no DOD_SERIAL given,
        # they talk to it, not to the simulator (DOD_SERIAL=sim ./dod hcl … for that).
        if [[ -z "${DOD_SERIAL:-}" ]]; then
            board="$(find_port)"
            if [[ -n "$board" ]]; then
                export DOD_SERIAL="$board"
            fi
            echo "dod: hcl $tool on ${DOD_SERIAL:-sim (no board attached)}" >&2
        fi
        docker_args
        exec docker run "${args[@]}" "$IMAGE" python -m "hcl.tools.$tool" "${@:3}"
        ;;
    *)
        echo "dod: unknown command '$1'" >&2
        usage
        ;;
esac
